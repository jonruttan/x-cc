; lang.xon -- what this bundle is.

(lang "cc")

; Self-contained: this bundle depends on nothing but the platform.
;
; Helium, plus exactly the libraries this bundle imports and nothing
; ambient.  Radon is a particular set of libraries to load, and the set
; it loads (the numeric tower, JIT-compiled tokenizer analysers) costs
; ~9s of every invocation that a tool never uses.
(dialect he)

(requires-release "v0.13.0")

(entry "run.x")
